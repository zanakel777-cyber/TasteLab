# Nukopijuok šį failą į .env.local ir įrašyk tikras reikšmes iš komandos nario,
# kuris valdo Supabase projektą (arba Supabase → Project Settings → API, jei turi
# prieigą). Failas .env.local į Git nepatenka.
# Pavadinimai turi sutapti su šablono kodu (lib/supabase/*.ts).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
